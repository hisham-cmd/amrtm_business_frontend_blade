APP_NAME="آمر تم — الواجهة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Riyadh

# ═══ عنوان سيرفر الباك اند المنفصل (إلزامي) ═══
BACKEND_API_URL=http://127.0.0.1:8000

# لا حاجة لأي إعدادات قاعدة بيانات محلية — الواجهة لا تلمس DB
LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=public