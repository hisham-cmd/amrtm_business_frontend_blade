<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{--pri:#1A237E;--pri2:#283593;--pri3:#1565C0;--bg:#F4F6FB;--sur:#fff;--bc:rgba(26,35,126,.07);--t1:#0D1257;--t2:#3A4490;--t3:#7A82B8;--t4:#BDC2E0;--pd:rgba(26,35,126,.08);--sh:rgba(26,35,126,.08);--sh2:rgba(26,35,126,.18);}
html,body{background:var(--bg);color:var(--t1);min-height:100vh;overflow-x:hidden;}
body.ar,body.ar *:not(i){font-family:'Cairo',sans-serif;direction:rtl;}
body.en,body.en *:not(i){font-family:'Inter',sans-serif;direction:ltr;}

/* NAVBAR */
.nb{height:70px;display:flex;align-items:center;padding:0 2rem;gap:1rem;background:linear-gradient(135deg,#1A237E,#1565C0);box-shadow:0 2px 16px rgba(26,35,126,.3);position:sticky;top:0;z-index:200;}
.nb-logo{display:flex;align-items:center;gap:10px;cursor:pointer;text-decoration:none;}
.nb-logo-nm{font-size:20px;font-weight:900;color:#fff;}
.nb-mid{flex:1;}
.nb-right{display:flex;align-items:center;gap:7px;flex-shrink:0;}
.lng{display:flex;padding:2px;border-radius:8px;background:rgba(255,255,255,.15);gap:1px;}
.lt{padding:4px 8px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;color:rgba(255,255,255,.55);transition:all .2s;}
.lt.on{background:rgba(255,255,255,.22);color:#fff;}
.nb-btn{display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border-radius:8px;font-family:inherit;font-size:12.5px;font-weight:700;cursor:pointer;transition:all .2s;border:none;text-decoration:none;}
.nb-btn.out{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.25);color:#fff;}
.nb-btn.out:hover{background:rgba(255,255,255,.28);}
.nb-btn.sol{background:#fff;color:var(--pri);}
.nb-btn.sol:hover{background:rgba(255,255,255,.9);}
.nb-user{display:flex;align-items:center;gap:7px;padding:4px 10px;border-radius:9px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);cursor:pointer;}
.nb-user-nm{font-size:12px;font-weight:700;color:#fff;}
.nb-user-av{width:30px;height:30px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(255,255,255,.35);}

/* BREADCRUMB */
.bc-bar{background:var(--sur);border-bottom:1px solid var(--bc);padding:.7rem 2rem;}
.bc{display:flex;align-items:center;gap:6px;max-width:1100px;margin:0 auto;font-size:12.5px;color:var(--t3);}
.bc a{color:var(--t3);text-decoration:none;transition:color .15s;}
.bc a:hover{color:var(--pri);}
.bc-sep{font-size:11px;}
.bc-cur{color:var(--t2);font-weight:700;}

/* PAGE HEADER */
.ph{padding:2.5rem 2rem 2rem;max-width:1100px;margin:0 auto;}
.ph-inner{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;}
.ph-ico{width:72px;height:72px;border-radius:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ph-ico i{font-size:34px;}
.ph-title{font-size:26px;font-weight:900;color:var(--t1);}
.ph-sub{font-size:14px;color:var(--t3);margin-top:4px;max-width:500px;line-height:1.6;}
.ph-badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
.ph-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;background:var(--pd);font-size:12px;font-weight:700;color:var(--pri);}
.ph-badge.verified{background:rgba(16,185,129,.1);color:#059669;}

/* SEARCH BAR */
.search-wrap{padding:0 2rem;max-width:1100px;margin:0 auto 1.5rem;}
.search-box{display:flex;align-items:center;gap:10px;background:var(--sur);border:1.5px solid var(--bc);border-radius:14px;padding:0 16px;box-shadow:0 2px 8px var(--sh);}
.search-box i{color:var(--t3);font-size:16px;flex-shrink:0;}
.search-box input{flex:1;border:none;outline:none;font-family:inherit;font-size:14px;color:var(--t1);padding:12px 0;background:transparent;}
.search-box input::placeholder{color:var(--t4);}

/* OFFICE GRID */
.off-wrap{padding:0 2rem 3rem;max-width:1100px;margin:0 auto;}
.off-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.3rem;}

/* OFFICE CARD */
.oc{border-radius:18px;border:1.5px solid var(--bc);background:var(--sur);overflow:hidden;box-shadow:0 4px 18px var(--sh);transition:all .25s;display:flex;flex-direction:column;text-decoration:none;color:inherit;cursor:pointer;}
.oc:hover{transform:translateY(-5px);box-shadow:0 20px 44px var(--sh2);}
.oc-head{padding:1.4rem 1.4rem 1rem;display:flex;align-items:flex-start;gap:1rem;}
.oc-av{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px;font-weight:900;color:#fff;transition:transform .25s;}
.oc:hover .oc-av{transform:scale(1.06);}
.oc-meta{flex:1;min-width:0;}
.oc-nm{font-size:15px;font-weight:800;color:var(--t1);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.oc-badges{display:flex;gap:5px;flex-wrap:wrap;}
.oc-badge{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;}
.oc-badge.ver{background:rgba(16,185,129,.1);color:#059669;border:1px solid rgba(16,185,129,.2);}
.oc-badge.pend{background:rgba(245,158,11,.1);color:#d97706;border:1px solid rgba(245,158,11,.2);}
.oc-badge.type{background:var(--pd);color:var(--pri);}
.oc-body{padding:.2rem 1.4rem 1rem;flex:1;}
.oc-desc{font-size:13px;color:var(--t3);line-height:1.65;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.oc-foot{padding:.85rem 1.4rem;border-top:1px solid var(--bc);background:#F8F9FF;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
.oc-info{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--t3);}
.oc-info i{font-size:13px;color:var(--t3);}
.oc-spec{display:flex;gap:5px;flex-wrap:wrap;padding:.6rem 1.4rem .9rem;}
.oc-spec-tag{padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;background:var(--pd);color:var(--pri2);}

/* EMPTY STATE */
.empty{text-align:center;padding:5rem 2rem;color:var(--t3);}
.empty-ico{width:80px;height:80px;border-radius:24px;display:flex;align-items:center;justify-content:center;background:var(--pd);margin:0 auto 1.2rem;font-size:36px;}
.empty h3{font-size:18px;font-weight:800;color:var(--t2);margin-bottom:8px;}
.empty p{font-size:14px;line-height:1.7;max-width:380px;margin:0 auto 1.5rem;}
.empty-btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:12px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;border:none;background:linear-gradient(135deg,var(--pri),var(--pri3));color:#fff;box-shadow:0 6px 20px rgba(26,35,126,.3);transition:opacity .2s;}
.empty-btn:hover{opacity:.88;}

/* REGISTER CTA BANNER */
.cta-banner{margin:0 2rem 2.5rem;max-width:1100px;margin-left:auto;margin-right:auto;border-radius:20px;padding:1.8rem 2rem;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;background:linear-gradient(135deg,rgba(26,35,126,.07),rgba(21,101,192,.07));border:1.5px solid rgba(26,35,126,.12);}
.cta-banner-ico{width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:26px;}
.cta-banner-text{flex:1;min-width:0;}
.cta-banner-title{font-size:16px;font-weight:800;color:var(--t1);margin-bottom:4px;}
.cta-banner-sub{font-size:13px;color:var(--t3);}
.cta-banner-actions{display:flex;gap:9px;flex-shrink:0;flex-wrap:wrap;}
.cta-btn{display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border-radius:10px;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none;border:none;transition:all .2s;white-space:nowrap;}
.cta-btn.pri{background:linear-gradient(135deg,var(--pri),var(--pri3));color:#fff;box-shadow:0 6px 18px rgba(26,35,126,.3);}
.cta-btn.pri:hover{opacity:.88;transform:translateY(-1px);}
.cta-btn.sec{background:var(--pd);color:var(--pri);border:1.5px solid rgba(26,35,126,.15);}
.cta-btn.sec:hover{background:rgba(26,35,126,.14);}

/* FOOTER */
.footer{background:linear-gradient(135deg,#1A237E,#1565C0);margin-top:2rem;padding:1.2rem 2rem;text-align:center;}
.f-cp{font-size:12px;color:rgba(255,255,255,.55);}

::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-thumb{background:rgba(26,35,126,.2);border-radius:4px;}

@media(max-width:700px){
  .nb{padding:0 1rem;}
