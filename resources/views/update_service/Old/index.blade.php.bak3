        fl_p: "Privacy Policy",
        fcal: "Address",
        fca: "Kingdom of Saudi Arabia, Jeddah - Al-Hamra District",
        fcpl: "Phone",
        fcel: "Email",
        fcp: "© 2025 Amrtm — All Rights Reserved",
        fb1: "Privacy Policy",
        fb2: "Terms of Use",
        fb3: "Contact Us",
    },
};

/* ══ CARD CONFIG — keys match DB category keys from seeder ══ */
const CC = {
    ministries: {
        color: "#1A237E",
        bg: "rgba(26,35,126,.1)",
        icon: "ti-building-bank",
        dk: "desc_min",
    },
